{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "stosyncrad/platform",
    "type": "project",
    "description": "StoSyncRad - white-label single-company multi-branch stock management platform (Laravel 13, MySQL 8.4).",
    "keywords": ["inventory", "warehouse", "stock", "laravel", "mysql"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "brick/math": "^1.0",
        "inertiajs/inertia-laravel": "^3.5",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "openspout/openspout": "^4.28 || ^5.0",
        "pragmarx/google2fa": "^9.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "audit:platform": [
            "@php artisan permissions:audit-routes",
            "@php artisan schema:audit-routes",
            "@php artisan config:registry:validate"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
