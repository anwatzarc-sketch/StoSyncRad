# -----------------------------------------------------------------------------------------------
# Infrastructure only (Spec Chapter 16 §16.2). Business configuration, branding, roles and policies
# are NOT set here: Platform Setup and Administration manage them in the configuration registry.
# -----------------------------------------------------------------------------------------------

APP_NAME=Stock
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://stock.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- PostgreSQL 16+ (the only supported database) ----------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stosyncrad
DB_SSLMODE=require
# Runtime role: no DDL; cannot UPDATE/DELETE ledger or audit tables
DB_USERNAME=stosyncrad_app
DB_PASSWORD=h9tu_57P6
# Deployment role: migrations and platform:* commands only (never used by web requests)
DB_DEPLOY_USERNAME=stosyncrad_deploy
DB_DEPLOY_PASSWORD=
# Reporting role: SELECT on reporting.* views only, read-only transactions
DB_REPORTING_USERNAME=stosyncrad_reporting
DB_REPORTING_PASSWORD=
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
DB_REPORTING_STATEMENT_TIMEOUT_MS=15000
DB_REPORTING_EXPORT_TIMEOUT_MS=120000
DB_REPORTING_LOCK_TIMEOUT_MS=2000

# --- Sessions (cookie-based SPA auth; HTTPS only in production) ---------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Hosts whose browser requests use session auth (defaults to APP_URL's host)
SANCTUM_STATEFUL_DOMAINS=stock.example.com

# --- Queue, cache, files ------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
FILESYSTEM_PRIVATE_DISK=private
# Private storage (exports, brand assets, imports) — must not be web-reachable
PRIVATE_STORAGE_ROOT=

# --- Mail (optional; notifications also arrive in-app) -------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Misc -----------------------------------------------------------------------------------------
PDF_RENDERER=dompdf
# Comma-separated proxy IPs/CIDRs when behind a load balancer
TRUSTED_PROXIES=
# Headless setup only: file containing the Super Admin password (read once, never stored)
SETUP_SUPERADMIN_PASSWORD_FILE=

VITE_APP_NAME="${APP_NAME}"
